{
  "name": "studwell",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "runtime:check": "node scripts/check-runtime.mjs",
    "start": "node scripts/check-runtime.mjs && node .output/server/index.mjs",
    "prebuild": "npm run runtime:check",
    "build": "nuxt build",
    "build:task-worker": "node scripts/build-task-worker.ts",
    "predev": "npm run runtime:check && npm run search:index",
    "dev": "nuxt dev --host 127.0.0.1",
    "pregenerate": "npm run runtime:check",
    "postgenerate": "npm run search:index -- --output .output/public/search",
    "generate": "nuxt generate",
    "preview": "node scripts/check-runtime.mjs && nuxt preview",
    "preview:lan": "node scripts/check-runtime.mjs && nuxt preview --host 0.0.0.0 --port 3001 --strictPort --dotenv .env.preview",
    "postinstall": "nuxt prepare",
    "search:index": "node scripts/generate-search-index.mjs",
    "password:blocklist:update": "node scripts/update-password-blocklist.mjs",
    "db": "node scripts/database.mjs",
    "db:init": "npm run db -- init",
    "db:samples": "npm run db -- samples",
    "db:site": "npm run db -- site",
    "db:check": "npm run db -- check",
    "db:generate": "npm run db -- generate",
    "db:migrate": "npm run db -- migrate",
    "db:sync:rbac": "npm run db -- sync:rbac",
    "test:db": "node --env-file=.env.test node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "test:production": "npm run build && node --env-file=.env.test --test tests/production/images.test.mjs",
    "typecheck": "nuxt typecheck && tsc --project scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "argon2": "0.45.1",
    "croner": "10.0.1",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "h3": "1.15.11",
    "ipx": "4.0.0-beta.1",
    "lucide-vue-next": "^1.0.0",
    "mysql2": "^3.24.6",
    "nodemailer": "10.4.0",
    "nuxt": "4.6.2",
    "pinia": "4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "license": "MIT"
}
