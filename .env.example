# Studwell 本地配置示例
# 私有数据库连接，密码中的特殊字符需要 URL 编码。部署时注入同名变量。
NUXT_DATABASE_URL=mysql://studwell:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/studwell_dev
# 可选：开发库迁移账号，必须与运行连接指向同一实例和库；留空时使用 NUXT_DATABASE_URL。
DATABASE_MIGRATION_URL=

# 公开媒体根目录；默认public（仅产物部署时.output/public），新上传写入uploads；生产需持久化并备份（含同级.data/media-trash），上传文件不打入构建产物。
NUXT_MEDIA_STORAGE_PATH=./public

# 站内搜索持久目录；生产设置为部署目录之外的绝对路径，Web 与任务进程共用。
NUXT_SEARCH_STORAGE_PATH=./.data/search

# 后台同源可信地址，必须与浏览器实际访问的协议/域名/端口完全一致，无末尾斜线。
NUXT_ADMIN_ORIGIN=http://127.0.0.1:3000
# 本地 HTTP 可设 false；HTTPS staging/production 必须 true。
NUXT_ADMIN_COOKIE_SECURE=false
# 默认不信任转发头；使用代理时只列出直接代理的精确 IP，并由代理覆盖 X-Real-IP。
NUXT_ADMIN_TRUSTED_PROXY_IPS=

# 可选，服务端专用。咨询邮件功能默认关闭；凭据含特殊字符时需 URL 编码。
NUXT_INQUIRY_SMTP_URL=